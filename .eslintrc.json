{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": [
    ".next/",
    "out/",
    ".wrangler/",
    "node_modules/",
    "next-env.d.ts"
  ],
  "rules": {
    "react/no-unescaped-entities": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "prefer-const": "warn",
    "@typescript-eslint/no-explicit-any": "off"
  }
}
