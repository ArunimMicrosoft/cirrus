    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.5.4",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "wrangler": "3.83.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
